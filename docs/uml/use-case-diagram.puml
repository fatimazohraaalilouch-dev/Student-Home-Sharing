@startuml
title Home Sharing — Diagramme de cas d'utilisation (Lot M1)
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Propriétaire\n(OWNER)" as Owner
actor "Locataire\n(TENANT)" as Tenant
actor "Service de vérification\nautomatique (OCR)" as Verifier

rectangle "Home Sharing — Annonces et preuve d'autorisation (M1)" {
  usecase "S'inscrire" as UC_Register
  usecase "Se connecter" as UC_Login

  usecase "Créer une annonce\n(brouillon)" as UC_Create
  usecase "Consulter « Mes annonces »" as UC_MyListings
  usecase "Consulter le détail\nde ses annonces" as UC_Details
  usecase "Modifier une annonce" as UC_Edit
  usecase "Supprimer une annonce" as UC_Delete
  usecase "Ajouter / organiser\nles photos" as UC_Photos
  usecase "Déposer une preuve\nd'autorisation" as UC_Proof
  usecase "Consulter le statut\nde la preuve" as UC_ProofStatus
  usecase "Soumettre l'annonce\nà vérification" as UC_Submit
  usecase "Vérifier automatiquement\nla preuve (OCR + cohérence)" as UC_Verify
  usecase "Consulter le statut\nde l'annonce" as UC_Status

  usecase "Consulter une annonce\npubliée" as UC_PublicListing
}

Owner --> UC_Register
Owner --> UC_Login
Owner --> UC_Create
Owner --> UC_MyListings
Owner --> UC_Details
Owner --> UC_Edit
Owner --> UC_Delete
Owner --> UC_Photos
Owner --> UC_Proof
Owner --> UC_ProofStatus
Owner --> UC_Submit
Owner --> UC_Status

UC_Submit .> UC_Verify : <<include>>
Verifier --> UC_Verify

Tenant --> UC_PublicListing

UC_Create .> UC_Photos : <<extend>>
UC_Submit .> UC_Proof : <<include>>

note right of UC_PublicListing
  Cas d'utilisation d'intégration avec M2 :
  seules les annonces PUBLISHED sont visibles
  dans la recherche publique.
end note

note bottom of UC_Verify
  Aucun modérateur humain :
  décision automatisée par OCR et règles
  de cohérence. L'application affiche
  « vérifié automatiquement », jamais « certifié ».
end note
@enduml
