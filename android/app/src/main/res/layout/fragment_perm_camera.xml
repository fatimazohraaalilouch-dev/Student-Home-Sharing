<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shs_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perm_bar_profile_photo"
            android:textAppearance="@style/TextAppearance.Shs.SectionTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:accessibilityHeading="true"
            android:text="@string/perm_headline"
            android:textAppearance="@style/TextAppearance.Shs.SectionTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/perm_camera_hint"
            android:textAppearance="@style/TextAppearance.Shs.Body"
            android:textColor="@color/shs_on_surface_variant" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Shs.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_24">

                <ImageView
                    android:layout_width="@dimen/perm_icon_size"
                    android:layout_height="@dimen/perm_icon_size"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_perm_camera"
                    app:tint="@color/shs_teal" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/perm_camera_title"
                    android:textAppearance="@style/TextAppearance.Shs.SectionTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="@string/perm_camera_body"
                    android:textAppearance="@style/TextAppearance.Shs.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAllow"
                    style="@style/Widget.Shs.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/perm_camera_allow" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeny"
                    style="@style/Widget.Shs.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="@string/perm_deny" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/perm_footer"
            android:textAppearance="@style/TextAppearance.Shs.Body"
            android:textColor="@color/shs_on_surface_variant" />
    </LinearLayout>
</ScrollView>