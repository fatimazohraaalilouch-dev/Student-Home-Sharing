<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shs_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/account_bar_my_account"
            android:textAppearance="@style/TextAppearance.Shs.SectionTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Shs.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/account_card_top">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding_compact">

                <ImageView
                    android:layout_width="@dimen/perm_icon_size"
                    android:layout_height="@dimen/perm_icon_size"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_state_lock"
                    app:tint="@color/shs_on_surface_variant" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:accessibilityHeading="true"
                    android:text="@string/account_logout_title"
                    android:textAppearance="@style/TextAppearance.Shs.SectionTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="@string/account_logout_body"
                    android:textAppearance="@style/TextAppearance.Shs.Body"
                    android:textColor="@color/shs_on_surface_variant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    style="@style/Widget.Shs.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/account_logout_confirm" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStay"
                    style="@style/Widget.Shs.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="@string/account_logout_stay" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>