<?xml version="1.0" encoding="utf-8"?>
<!-- Préférences · Langue (maquette « Préférences · Langue ») -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shs_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_16"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:background="@drawable/bg_back_button"
                    android:contentDescription="@string/auth_back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/shs_on_background" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_language_tag"
                    android:textAppearance="@style/TextAppearance.Shs.Label"
                    android:textColor="@color/shs_on_surface_variant" />
            </LinearLayout>

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_24"
                android:background="@drawable/bg_info_card"
                android:importantForAccessibility="no"
                android:padding="@dimen/space_12"
                android:src="@drawable/ic_translate"
                app:tint="@color/shs_teal_accent" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/auth_language_title"
                android:textAppearance="@style/TextAppearance.Shs.ScreenTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/auth_language_subtitle"
                android:textAppearance="@style/TextAppearance.Shs.Body"
                android:textColor="@color/shs_on_surface_variant" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_fr"
                style="@style/Widget.Shs.OptionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="@dimen/icon_badge_box"
                        android:layout_height="@dimen/icon_badge_box"
                        android:background="@drawable/bg_language_badge"
                        android:gravity="center"
                        android:text="@string/auth_language_fr_badge"
                        android:textAppearance="@style/TextAppearance.Shs.SectionTitle"
                        android:textColor="@color/shs_teal_accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auth_language_fr_name"
                            android:textAppearance="@style/TextAppearance.Shs.Body"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auth_language_fr_sub"
                            android:textAppearance="@style/TextAppearance.Shs.Label"
                            android:textColor="@color/shs_on_surface_variant" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_fr_check"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/shs_teal_accent" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_ar"
                style="@style/Widget.Shs.OptionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="@dimen/icon_badge_box"
                        android:layout_height="@dimen/icon_badge_box"
                        android:background="@drawable/bg_language_badge"
                        android:gravity="center"
                        android:text="@string/auth_language_ar_badge"
                        android:textAppearance="@style/TextAppearance.Shs.SectionTitle"
                        android:textColor="@color/shs_teal_accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auth_language_ar_name"
                            android:textAppearance="@style/TextAppearance.Shs.Body"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auth_language_ar_sub"
                            android:textAppearance="@style/TextAppearance.Shs.Label"
                            android:textColor="@color/shs_on_surface_variant" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_ar_check"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_radio_unchecked"
                        app:tint="@color/shs_outline" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_en"
                style="@style/Widget.Shs.OptionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="@dimen/icon_badge_box"
                        android:layout_height="@dimen/icon_badge_box"
                        android:background="@drawable/bg_language_badge"
                        android:gravity="center"
                        android:text="@string/auth_language_en_badge"
                        android:textAppearance="@style/TextAppearance.Shs.SectionTitle"
                        android:textColor="@color/shs_teal_accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auth_language_en_name"
                            android:textAppearance="@style/TextAppearance.Shs.Body"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auth_language_en_sub"
                            android:textAppearance="@style/TextAppearance.Shs.Label"
                            android:textColor="@color/shs_on_surface_variant" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_en_check"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_radio_unchecked"
                        app:tint="@color/shs_outline" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_16">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/auth_language_rtl_note"
            android:textAppearance="@style/TextAppearance.Shs.Label"
            android:textColor="@color/shs_on_surface_variant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_continue"
            style="@style/Widget.Shs.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/auth_language_label_fr"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd" />
    </LinearLayout>
</LinearLayout>
