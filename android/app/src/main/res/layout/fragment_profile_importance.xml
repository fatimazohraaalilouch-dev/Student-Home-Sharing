<?xml version="1.0" encoding="utf-8"?>
<!-- Profil locataire 3 · Importance des critères (maquette « Tenant · Profil · 3 Importance des critères »). Valeurs par défaut = celles de la base : 90, 75, 70, 40. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shs_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_16"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_16">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="@drawable/bg_back_button"
                android:contentDescription="@string/search_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/shs_on_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/search_profile_3_title"
                android:textAppearance="@style/TextAppearance.Shs.ScreenTitle" />

            <TextView
                android:id="@+id/tv_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:textAppearance="@style/TextAppearance.Shs.Label"
                android:textColor="@color/shs_teal_accent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="horizontal">
                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/step_bar_height"
                    android:layout_weight="1"
                    android:background="@drawable/bg_step_active" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/step_bar_height"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_step_active" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/step_bar_height"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_step_active" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/search_profile_3_section"
                android:textAppearance="@style/TextAppearance.Shs.SectionTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/search_profile_3_intro"
                android:textAppearance="@style/TextAppearance.Shs.Body"
                android:textColor="@color/shs_on_surface_variant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/search_profile_3_budget"
                    android:textAppearance="@style/TextAppearance.Shs.Body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_budget_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Shs.Body"
                    android:textColor="@color/shs_teal_accent"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_importance_budget"
                style="@style/Widget.Shs.Slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                app:tickVisible="false"
                android:value="90"
                android:valueFrom="0"
                android:valueTo="100" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/search_profile_3_distance"
                    android:textAppearance="@style/TextAppearance.Shs.Body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_distance_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Shs.Body"
                    android:textColor="@color/shs_teal_accent"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_importance_distance"
                style="@style/Widget.Shs.Slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                app:tickVisible="false"
                android:value="75"
                android:valueFrom="0"
                android:valueTo="100" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/search_profile_3_amenities"
                    android:textAppearance="@style/TextAppearance.Shs.Body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_amenities_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Shs.Body"
                    android:textColor="@color/shs_teal_accent"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_importance_amenities"
                style="@style/Widget.Shs.Slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                app:tickVisible="false"
                android:value="70"
                android:valueFrom="0"
                android:valueTo="100" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/search_profile_3_rating"
                    android:textAppearance="@style/TextAppearance.Shs.Body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_rating_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Shs.Body"
                    android:textColor="@color/shs_teal_accent"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_importance_rating"
                style="@style/Widget.Shs.Slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                app:tickVisible="false"
                android:value="40"
                android:valueFrom="0"
                android:valueTo="100" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_continue"
        style="@style/Widget.Shs.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/space_16"
        android:text="@string/search_profile_explore"
        app:icon="@drawable/ic_arrow_forward"
        app:iconGravity="textEnd" />
</LinearLayout>
