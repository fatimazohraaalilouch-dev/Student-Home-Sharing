<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Carte de choix (Rôle, Langue) : le contour et le fond « sélectionné » sont posés par OptionCard.applySelected -->
    <style name="Widget.Shs.OptionCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/shs_surface</item>
        <item name="strokeColor">@color/shs_outline</item>
        <item name="strokeWidth">@dimen/stroke_option_default</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <!-- Puce à cocher (types de logement, équipements) -->
    <style name="Widget.Shs.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Shs.Label</item>
        <item name="checkedIconTint">@color/shs_teal_accent</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">@dimen/radius_pill</item>
    </style>
    <!-- Curseur : piste active teal, piste inactive grise -->
    <style name="Widget.Shs.Slider" parent="Widget.Material3.Slider">
        <item name="trackColorActive">@color/shs_teal_accent</item>
        <item name="trackColorInactive">@color/shs_disabled_container</item>
        <item name="thumbColor">@color/shs_teal_accent</item>
        <item name="trackHeight">4dp</item>
    </style>
</resources>
