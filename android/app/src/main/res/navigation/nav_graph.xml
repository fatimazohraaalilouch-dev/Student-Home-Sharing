<?xml version="1.0" encoding="utf-8"?>
<!-- Graphe racine : un <include> par lot. Chaque lot ne modifie que son propre fichier nav_*.xml. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_auth">
    <include app:graph="@navigation/nav_auth" />
    <include app:graph="@navigation/nav_signup" />
    <include app:graph="@navigation/nav_tenant" />
    <include app:graph="@navigation/nav_tenant_profile" />
    <include app:graph="@navigation/nav_booking" />
    <include app:graph="@navigation/nav_messaging" />
    <include app:graph="@navigation/nav_owner" />
    <include app:graph="@navigation/nav_owner" />
    <include app:graph="@navigation/nav_copilot" />
    <include app:graph="@navigation/nav_common" />
    <include app:graph="@navigation/nav_settings" />

</navigation>